            <gradient android:angle="270" android:startColor="#3E7CF2" android:endColor="#8EC2FF"/>
            <corners android:radius="19dp"/>
        </shape>
    </item>
    <item android:top="10dp" android:left="14dp" android:right="14dp" android:height="38dp" android:gravity="top">
