<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#6B5A4A"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#9C9285"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#C9C1B5"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1B4D12"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1F8030"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="5dp" android:left="2dp" android:right="2dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#35BE4A" android:endColor="#35BE4A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#1B4D12"/>
                    <corners android:radius="16dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1F8030"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#8CEB6E" android:endColor="#35BE4A"/>
                    <corners android:radius="14dp"/>
                </shape>
            </item>
            <item android:top="4dp" android:left="8dp" android:right="8dp" android:height="9dp" android:gravity="top">
                <shape android:shape="rectangle">
                    <solid android:color="#55FFFFFF"/>
                    <corners android:radius="6dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
