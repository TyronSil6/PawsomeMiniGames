<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/rg_bg_forest" />

    <LinearLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="30dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <!-- HOW TO PLAY panel: same tan frame + cream card + dark pill title as the other games -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="24dp"
                android:background="@drawable/pm_panel_frame"
                android:orientation="vertical"
                android:padding="9dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/pm_panel_cream"
                    android:overScrollMode="ifContentScrolls"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="46dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <FrameLayout
                                android:id="@+id/how_slot_1"
                                android:layout_width="72dp"
                                android:layout_height="72dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/rg_how_1"
                                android:textColor="@color/pm_brown_text"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/pm_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <FrameLayout
                                android:id="@+id/how_slot_2"
                                android:layout_width="72dp"
                                android:layout_height="72dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/rg_how_2"
                                android:textColor="@color/pm_brown_text"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/pm_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/rg_icon_timer" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/rg_how_3"
                                android:textColor="@color/pm_brown_text"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/pm_divider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp">

                            <ImageView
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:importantForAccessibility="no"
                                android:padding="10dp"
                                android:src="@drawable/rg_icon_star" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:text="@string/rg_how_4"
                                android:textColor="@color/pm_brown_text"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </ScrollView>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="top|center_horizontal"
                android:background="@drawable/pm_pill_header"
                android:gravity="center"
                android:minWidth="210dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="3dp"
                android:text="@string/rg_how_to_play"
                android:textAllCaps="true"
                android:textColor="@color/pm_text_white"
                android:textSize="22sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/btn_start"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/pm_btn_red"
            android:clickable="true"
            android:drawableStart="@drawable/pm_ic_play"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="5dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/pm_btn_play"
            android:textColor="@color/pm_text_white"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_back"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/pm_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="@string/pm_btn_quit"
            android:textColor="@color/pm_cream_text"
            android:textSize="24sp" />
    </LinearLayout>
</FrameLayout>
