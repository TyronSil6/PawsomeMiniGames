<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/rg_bg_forest" />

    <LinearLayout
        android:id="@+id/safe_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="30dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/rg_cd_logo"
            android:scaleType="fitCenter"
            android:src="@drawable/rg_logo_reaction_game" />

        <!-- Best score chip, same as Pop Mania's home screen -->
        <TextView
            android:id="@+id/tv_best"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/pm_panel_chip"
            android:paddingStart="20dp"
            android:paddingTop="7dp"
            android:paddingEnd="20dp"
            android:paddingBottom="7dp"
            android:textAllCaps="true"
            android:textColor="@color/pm_gold"
            android:textSize="16sp" />

        <!-- All menu buttons across the games share the same size: 300dp x 68dp -->
        <TextView
            android:id="@+id/btn_play"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pm_btn_red"
            android:clickable="true"
            android:drawableStart="@drawable/pm_ic_play"
            android:drawablePadding="14dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="5dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="@string/pm_btn_play"
            android:textColor="@color/pm_text_white"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btn_leaderboard"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pm_btn_gold"
            android:clickable="true"
            android:drawableStart="@drawable/pm_ic_trophy"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="5dp"
            android:text="@string/pm_btn_leaderboard"
            android:textColor="@color/pm_brown_text"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/btn_quit"
            android:layout_width="300dp"
            android:layout_height="68dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/pm_btn_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingBottom="5dp"
            android:text="@string/pm_btn_quit"
            android:textColor="@color/pm_cream_text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/rg_tagline"
            android:textColor="#FFF6E2"
            android:textSize="16sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
