<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/bg_menu"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Guidelines -->
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gL"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"   app:layout_constraintGuide_percent="0.12"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"   app:layout_constraintGuide_percent="0.485"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gM2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"   app:layout_constraintGuide_percent="0.515"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gR"  android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical"   app:layout_constraintGuide_percent="0.88"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gR1t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.27"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gR1b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.52"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gR2t" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.54"/>
    <androidx.constraintlayout.widget.Guideline android:id="@+id/gR2b" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" app:layout_constraintGuide_percent="0.79"/>

    <!-- Top buttons -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_marginTop="40dp" android:layout_marginStart="16dp"
        android:src="@drawable/ic_settings"
        android:scaleType="fitCenter" android:padding="14dp"
        android:contentDescription="Settings"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <ImageButton
        android:id="@+id/btnMore"
        android:layout_width="56dp" android:layout_height="56dp"
        android:layout_marginTop="40dp" android:layout_marginEnd="16dp"
        android:src="@drawable/ic_more"
        android:scaleType="fitCenter" android:padding="14dp"
        android:contentDescription="More"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Title sign: black lacquer board with gold studs, like the Critter Toss sign -->
    <FrameLayout
        android:id="@+id/bannerFrame"
        android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnSettings"
        app:layout_constraintEnd_toStartOf="@id/btnMore">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_margin="7dp"
            android:gravity="center" android:orientation="vertical"
            android:paddingTop="8dp" android:paddingBottom="8dp"
            android:paddingStart="12dp" android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PAWSOME"
                android:textColor="#FFD66B" android:textSize="30sp" android:textStyle="bold"
                android:shadowColor="#000000" android:shadowDx="0" android:shadowDy="4" android:shadowRadius="3"/>

            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="MINI GAMES"
                android:textColor="#FF6A45" android:textSize="22sp" android:textStyle="bold"
                android:shadowColor="#000000" android:shadowDx="0" android:shadowDy="4" android:shadowRadius="3"/>
        </LinearLayout>

        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="16dp" android:layout_gravity="top|start"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="16dp" android:layout_gravity="top|end"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="16dp" android:layout_gravity="bottom|start"/>
        <View android:layout_width="12dp" android:layout_height="12dp" android:layout_margin="16dp" android:layout_gravity="bottom|end"/>
    </FrameLayout>

    <!-- Tagline, same style as Critter Toss's "Aim true, toss big!" -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Pick a game to play!"
        android:textColor="#FFF8E3" android:textSize="18sp" android:textStyle="italic"
        android:shadowColor="#000000" android:shadowDx="0" android:shadowDy="3" android:shadowRadius="4"
        app:layout_constraintTop_toBottomOf="@id/bannerFrame"
        app:layout_constraintStart_toStartOf="@id/bannerFrame"
        app:layout_constraintEnd_toEndOf="@id/bannerFrame"/>

    <!-- 2x2 game cards -->
    <include android:id="@+id/cardSakura" layout="@layout/item_game_card"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gR1t" app:layout_constraintBottom_toTopOf="@id/gR1b"
        app:layout_constraintStart_toEndOf="@id/gL" app:layout_constraintEnd_toStartOf="@id/gM1"/>

    <include android:id="@+id/cardCritter" layout="@layout/item_game_card"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gR1t" app:layout_constraintBottom_toTopOf="@id/gR1b"
        app:layout_constraintStart_toEndOf="@id/gM2" app:layout_constraintEnd_toStartOf="@id/gR"/>

    <include android:id="@+id/cardPop" layout="@layout/item_game_card"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gR2t" app:layout_constraintBottom_toTopOf="@id/gR2b"
        app:layout_constraintStart_toEndOf="@id/gL" app:layout_constraintEnd_toStartOf="@id/gM1"/>

    <include android:id="@+id/cardReaction" layout="@layout/item_game_card"
        android:layout_width="0dp" android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/gR2t" app:layout_constraintBottom_toTopOf="@id/gR2b"
        app:layout_constraintStart_toEndOf="@id/gM2" app:layout_constraintEnd_toStartOf="@id/gR"/>

    <!-- Bottom buttons -->
    <LinearLayout
        android:id="@+id/btnAbout"
        android:layout_width="wrap_content" android:layout_height="52dp"
        android:layout_marginStart="56dp" android:layout_marginBottom="28dp"
        android:gravity="center_vertical"
        android:paddingStart="14dp" android:paddingEnd="22dp"
        android:clickable="true" android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView android:layout_width="26dp" android:layout_height="26dp"
            android:src="@drawable/ic_info" android:contentDescription="@null"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="About Us"
            android:textColor="#4A2A14" android:textSize="17sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/btnQuit"
        android:layout_width="wrap_content" android:layout_height="52dp"
        android:layout_marginEnd="56dp" android:layout_marginBottom="28dp"
        android:gravity="center"
        android:paddingStart="28dp" android:paddingEnd="28dp"
        android:clickable="true" android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Quit"
            android:textColor="#4A2A14" android:textSize="17sp" android:textStyle="bold"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>