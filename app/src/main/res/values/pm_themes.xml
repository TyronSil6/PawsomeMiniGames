<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pop Mania screens: full screen, dark backdrop, same soft fade between screens as the rest of the app.
         The Outfit font is added for Android 8+ in values-v26 (the app still supports Android 7). -->
    <style name="PopMania.BaseTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/pm_bg_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Pawsome</item>
    </style>
    <style name="Theme.PawsomePopMania" parent="PopMania.BaseTheme" />

    <!-- Floating pop-up cards (Settings, Leaderboard, Quit) -->
    <style name="PopManiaDialog.Base" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.62</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    <style name="PopManiaDialog" parent="PopManiaDialog.Base" />
</resources>
